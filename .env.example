# Full reference: docs/reference/EnvVariables.md

# Database (SQLite)
# Points to prisma/dev.db (relative to schema.prisma)
DATABASE_URL="file:./dev.db"
# Hosted (Postgres) only: direct, non-pooled connection used for migrations. Not read by the SQLite build.
# DIRECT_URL=
# Self-host only, recovery only: set to 1 for the one container start that must apply a schema change that drops data
PRISMA_ACCEPT_DATA_LOSS=

# Public URL (for OAuth redirects and every link the bots send). Required whenever a bot token is set.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Discord Integration (optional; sign-in needs the app ID and client secret, channel posts and DMs need the bot token)
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Display name of the Discord bot, shown in the channel-permission instructions on the manage page
NEXT_PUBLIC_BOT_NAME=

# Telegram Integration (optional)
TELEGRAM_BOT_TOKEN=
# webhook | polling | off. Unset with a token: polling off Vercel, webhook when hosted or on Vercel. Off without one.
TELEGRAM_MODE=

# Deployment Mode
# Set to 'true' for the public hosted version (enables sitemap, SEO/AEO indexing, etc.)
# Leave unset or 'false' for self-hosted (privacy mode: noindex, no external tracking)
NEXT_PUBLIC_IS_HOSTED=false

# Set to 'true' at Docker build time only (switches to standalone Next.js output).
# The Dockerfile sets it, so leave it alone in .env.
IS_DOCKER_BUILD=false

# Logging
# Verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Security
# HMAC key for identity and participant cookies, Telegram connect codes, and the root of the
# per-destination outbound webhook signing keys; required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Bearer token for /api/cron/* and /api/telegram/setup. Not used for webhook signatures. Generate with: openssl rand -hex 32
CRON_SECRET=

# Ko-fi: verification token from your Ko-fi webhook settings; without it /api/kofi/webhook rejects every request
KOFI_VERIFICATION_TOKEN=

# Notifications
# Minutes between "updated their availability" group posts for the same person (0 to 1440, default 60; 0 posts every vote)
VOTE_ANNOUNCE_COOLDOWN_MINUTES=60

# Event Retention in days (defaults shown; they match the published privacy policy)
# Finalized: after the finalized slot ends (one-shot) or the last scheduled session ends (campaign)
CLEANUP_RETENTION_DAYS_FINALIZED=1
# Draft: after its last proposed time ends (a draft with no proposed times: after creation)
CLEANUP_RETENTION_DAYS_DRAFT=1
# Cancelled: after cancellation
CLEANUP_RETENTION_DAYS_CANCELLED=1
