# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/.vitest/

# next.js
/.next/
/out/

# production
/build


# IDE & Editors
.vscode/
.idea/
*.swp
*.swo

# System
.DS_Store
Thumbs.db

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local data
/data
*.db
*.db-journal



# backups from refactoring
*.old

# Database Backups
backups/

# Local planning & audit documents
BLOG-STRATEGY.md
ACTION-PLAN.md
FULL-AUDIT-REPORT.md
*_home.html




scratch/

# Local-only working files (never tracked)
CLAUDE.md
.claude/*
!.claude/*.json
.superpowers/
docs/superpowers/
memory/
MEMORY.md
tmp/

# Generated at build time from content/blog (scripts/generate-published-posts.mjs)
/shared/data/published-posts.generated.ts

# Public repo: tool config and strategy working docs stay local.
# The ".claude/" rule further down ignores that directory at every depth, so the
# .claude/* lines here are superseded; they stay so the ignore block remains standard.
.claude/*.json
.impeccable/
/briefs/
/strategy/
ACTION-PLAN.md
*AUDIT-REPORT*.md
*_STRATEGY.md

# Env and credential files; the example templates stay tracked.
.env.*
!.env.example
!.env.sample
!.env.template
.dev.vars
.dev.vars.*
!.dev.vars.example

# Public repo: no tool config at any depth, no strategy working docs.
.claude/
*BLOG_STRATEGY.md
*CONTENT_STRATEGY.md
*SEO_STRATEGY.md
*MARKETING_STRATEGY.md
