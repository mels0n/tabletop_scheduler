{
  "name": "tabletop_scheduler",
  "version": "0.1.0",
  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/generate-published-posts.mjs --dev",
    "dev": "next dev",
    "prebuild": "node scripts/generate-published-posts.mjs",
    "build": "next build",
    "build:hosted": "prisma generate --schema=prisma/hosted/schema.prisma && node scripts/generate-published-posts.mjs && next build",
    "build:selfhosted": "prisma generate --schema=prisma/schema.prisma && node scripts/generate-published-posts.mjs && next build",
    "db:status:hosted": "prisma migrate status --schema=prisma/hosted/schema.prisma",
    "db:new:hosted": "node scripts/db-hosted-migration.mjs",
    "db:diff:hosted": "node scripts/db-hosted-migration.mjs --dry-run",
    "db:baseline:hosted": "prisma migrate resolve --applied 0_init --schema=prisma/hosted/schema.prisma",
    "db:upgrade-check": "node scripts/selfhost-upgrade-check.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint . --max-warnings=0",
    "depcruise": "depcruise --config .dependency-cruiser.cjs app components features entities shared",
    "blog:queue": "node scripts/blog-queue.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-published-posts.mjs",
    "pretypecheck": "node scripts/generate-published-posts.mjs",
    "prelint": "node scripts/generate-published-posts.mjs",
    "predepcruise": "node scripts/generate-published-posts.mjs",
    "blog:generate": "node scripts/generate-published-posts.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "postcss": "^8",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  }
}
